# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
# Для vision-анализа рекомендуется использовать gpt-4o, gpt-4o-mini или gpt-4-turbo (все поддерживают изображения)
# gpt-4o-mini - более дешевая версия с теми же vision capabilities
OPENAI_MODEL=gpt-4o-mini
# Таймаут для LLM запросов (особенно важен для vision-анализа, который может занимать больше времени)
OPENAI_TIMEOUT=5m
OPENAI_MAX_RETRIES=3

# Browser Configuration
CHROME_PROFILE_DIR=C:\Users\Daniil Koreshkov\AppData\Local\Google\Chrome\User Data\Default
BROWSER_TIMEOUT=60s
BROWSER_NAVIGATION_TIMEOUT=60s
# Таймаут для click/type; 15–20s ускоряет при отсутствии элемента, но может чаще обрывать медленные страницы
BROWSER_ACTION_TIMEOUT=60s
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# Agent Configuration
AGENT_MAX_STEPS=100
AGENT_CRITIC_INTERVAL=5
AGENT_EPHEMERAL_SIZE=3
AGENT_WORKING_SUMMARY_SIZE=1500
AGENT_MAX_RETRIES=3
AGENT_DRY_RUN=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_FILE=

# Run Directory
RUN_DIR=./runs

